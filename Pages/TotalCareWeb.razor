<!-- ═══════════════════════════════════════ STYLES ═══════════════════════════════════════ -->
<style>
    /* ── Variables ── */
    :root {
        --tc-orange:   #EC7C26;
        --tc-orange-d: #C9621A;
        --tc-orange-l: #FF9F55;
        --tc-amber:    #F5A623;
        --tc-coal:     #0F0A05;
        --tc-dark:     #1A1008;
        --tc-card-bg:  #FFFFFF;
        --tc-text:     #1a1a1a;
        --tc-muted:    #6B7280;
        --tc-border:   rgba(236,124,38,0.18);
        --tc-radius:   14px;
        --tc-shadow:   0 4px 24px rgba(236,124,38,0.10);
        --tc-transition: 220ms ease;
    }

    /* ── Reset & Base ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Barlow', 'Inter', sans-serif; background: #f8f5f0; color: var(--tc-text); overflow-x: hidden; }

    /* ── NAV ── */
    .tc-nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 200;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(14px) saturate(1.5);
        border-bottom: 1px solid rgba(236,124,38,0.10);
        transition: background var(--tc-transition), box-shadow var(--tc-transition), border-color var(--tc-transition);
    }
    .tc-nav--scrolled {
        background: rgba(255,255,255,0.97);
        box-shadow: 0 2px 20px rgba(236,124,38,0.10);
        border-color: rgba(236,124,38,0.2);
    }
    .tc-nav__inner {
        max-width: 1280px; margin: 0 auto;
        padding: 0 clamp(1rem, 3vw, 2rem);
        height: 68px;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }
    /* brand — always left */
    .tc-nav__brand {
        display: flex; align-items: center; gap: 8px;
        flex: 1; justify-content: flex-start; min-width: 0;
    }
    .tc-nav__brand-dot {
        width: 8px; height: 8px; flex-shrink: 0;
        background: var(--tc-orange);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--tc-orange);
        animation: tc-pulse 2s ease-in-out infinite;
    }
    @@keyframes tc-pulse {
        0%,100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.6); opacity: 0.6; }
    }
    .tc-nav__brand-text {
        font-family: 'Bebas Neue', 'Barlow', sans-serif;
        font-size: clamp(0.75rem, 2vw, 1.15rem);
        letter-spacing: 0.06em;
