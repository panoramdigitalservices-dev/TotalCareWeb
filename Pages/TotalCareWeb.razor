        { x:    '0px', scale: 1.00, opacity: 1.00, z: 10 },
        { x:  '310px', scale: 0.77, opacity: 0.52, z: 2  },
        { x:  '560px', scale: 0.60, opacity: 0.20, z: 1  },
        ];

        function makeDots() {
            dotsEl.innerHTML = '';
            cards.forEach(function (_, i) {
                var d = document.createElement('button');
                d.className = 'nc-dot' + (i === cur ? ' on' : '');
                d.dataset.i = i;
                d.setAttribute('aria-label', 'Slide ' + (i + 1));
                d.addEventListener('click', function () { goTo(+this.dataset.i); });
                dotsEl.appendChild(d);
            });
        }

        function render() {
            cards.forEach(function (card, i) {
                var offset = ((i - cur) % n + n) % n;
                if (offset > n / 2) offset -= n;
                var idx = Math.max(0, Math.min(4, offset + 2));
                var p = positions[idx];
                var visible = Math.abs(offset) <= 2;
                card.style.transform = 'translateX(' + p.x + ') scale(' + p.scale + ')';
                card.style.opacity = visible ? p.opacity : '0';
                card.style.zIndex = p.z;
                card.style.pointerEvents = offset === 0 ? 'auto' : 'none';
            });
            dotsEl.querySelectorAll('.nc-dot').forEach(function (d, i) {
                d.className = 'nc-dot' + (i === cur ? ' on' : '');
            });
        }

        function goTo(idx) {
            cur = ((idx % n) + n) % n;
            elapsed = 0;
            if (prog) prog.style.width = '0%';
            render();
        }

        document.getElementById('ncPrev').addEventListener('click', function () { goTo(cur - 1); });
        document.getElementById('ncNext').addEventListener('click', function () { goTo(cur + 1); });

        if (root) {
            root.addEventListener('mouseenter', function () { paused = true; });
            root.addEventListener('mouseleave', function () { paused = false; });
        }

        var startX = 0;
        if (root) {
            root.addEventListener('touchstart', function (e) {
                startX = e.touches[0].clientX; paused = true;
            }, { passive: true });
            root.addEventListener('touchend', function (e) {
                var diff = startX - e.changedTouches[0].clientX;
                if (Math.abs(diff) > 40) diff > 0 ? goTo(cur + 1) : goTo(cur - 1);
                paused = false;
            });
        }

        function tick(ts) {
            if (!last) last = ts;
            if (!paused) {
                elapsed += ts - last;
                var pct = Math.min(100, (elapsed / INTERVAL) * 100);
                if (prog) prog.style.width = pct + '%';
                if (elapsed >= INTERVAL) goTo(cur + 1);
            }
            last = ts;
            requestAnimationFrame(tick);
        }

        makeDots();
        render();
        requestAnimationFrame(tick);
    })();



        // ── Scroll reveal ──
        var revealEls = document.querySelectorAll('.tc-reveal');
        var revealObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    e.target.classList.add('visible');
                    revealObserver.unobserve(e.target);
                }
            });
        }, { threshold: 0.12 });
        revealEls.forEach(function (el) { revealObserver.observe(el); });

</script>


@code {
    private string email = "";
    private string statusMessage = "";
    private bool isSuccess = false;
    private bool showMobileMenu = false;
    private bool isScrolled = false;

    // Carousel state
    private readonly List<string> carouselImages = new()
    {
        "images/welding.jpeg",
        "images/fork-lift.jpeg",
        "images/wiring.jpeg"
    };

    private int currentIndex = 0;
    private System.Threading.Timer? carouselTimer;
    private readonly int carouselIntervalMs = 4000;

    private void ResetCarouselTimer()
    {
        carouselTimer?.Change(carouselIntervalMs, carouselIntervalMs);
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
    }

    private async Task HandleNotifyMe()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            statusMessage = "Please enter a valid email address";
            isSuccess = false;
            return;
        }

        if (!IsValidEmail(email))
        {
            statusMessage = "Please enter a valid email format";
            isSuccess = false;
            return;
        }

        statusMessage = "Thank you! We'll notify you when we launch.";
        isSuccess = true;

        await Task.Delay(3000);
        email = "";
        statusMessage = "";
        StateHasChanged();
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    protected override void OnInitialized()
    {
        carouselTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                currentIndex = (currentIndex + 1) % carouselImages.Count;
                StateHasChanged();
            });
        }, null, carouselIntervalMs, carouselIntervalMs);
    }

    public void Dispose()
    {
        carouselTimer?.Dispose();
    }
}
