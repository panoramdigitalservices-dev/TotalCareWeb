<!-- ═══════════════════════════════════════ STYLES ═══════════════════════════════════════ -->
<style>
    /* ── Variables ── */
    :root {
        --tc-orange: #EC7C26;
        --tc-orange-d: #C9621A;
        --tc-orange-l: #FF9F55;
        --tc-amber: #F5A623;
        --tc-coal: #0F0A05;
        --tc-dark: #1A1008;
        --tc-card-bg: #FFFFFF;
        --tc-text: #1a1a1a;
        --tc-muted: #6B7280;
        --tc-border: rgba(236,124,38,0.18);
        --tc-radius: 14px;
        --tc-shadow: 0 4px 24px rgba(236,124,38,0.10);
        --tc-transition: 220ms ease;
    }

    /* ── Reset & Base ── */
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Barlow', 'Inter', sans-serif;
        background: #f8f5f0;
        color: var(--tc-text);
        overflow-x: hidden;
    }

    /* ── NAV ── */

    
    /* ── HERO ── */
    .tc-hero {
        position: relative;
        min-height: 100svh;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding-top: 68px;
    }

    /* carousel */
    .carousel {
        position: absolute;
        inset: 0;
        z-index: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        pointer-events: none;
    }

    .carousel-track {
        display: flex;
        width: 100%;
        height: 100%;
        transition: transform 850ms cubic-bezier(.2,.8,.2,1);
    }

    .carousel-slide {
        flex: 0 0 100%;
        position: relative;
        height: 100%;
    }

        .carousel-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            filter: none;
            transform: none;
            transition: none;
        }

    .carousel-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient( 180deg, rgba(0,0,0,0.42) 0%, rgba(0,0,0,0.25) 45%, rgba(0,0,0,0.50) 100% );
    }
    /* scan lines — very subtle, won't obscure clear carousel images */
    .tc-hero__scanlines {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        background: repeating-linear-gradient(0deg, transparent, transparent 4px, rgba(0,0,0,0.03) 4px, rgba(0,0,0,0.03) 5px);
    }
    /* animated grid dots — reduced opacity so image stays clear */
    .tc-hero__grid {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        background-image: radial-gradient(circle, rgba(236,124,38,0.09) 1px, transparent 1px);
        background-size: 48px 48px;
        animation: tc-grid-drift 18s ease-in-out infinite alternate;
    }

    @@keyframes tc-grid-drift {
        0% {
            background-position: 0 0;
        }

        100% {
            background-position: 24px 24px;
        }
    }

    /* hero content */
    .tc-hero__content {
        position: relative;
        z-index: 10;
        text-align: center;
        padding: clamp(1.5rem,4vw,3rem) clamp(1rem,5vw,4rem);
        max-width: 900px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    /* badge */
    .tc-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(236,124,38,0.15);
        border: 1px solid rgba(236,124,38,0.50);
        border-radius: 50px;
        padding: 0.4rem 1.1rem;
        font-size: clamp(0.7rem,1.5vw,0.82rem);
        font-weight: 600;
        letter-spacing: 0.1em;
        color: #fff;
        backdrop-filter: blur(8px);
    }

    .tc-badge__dot {
        width: 7px;
        height: 7px;
        flex-shrink: 0;
        background: var(--tc-orange);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--tc-orange);
        animation: tc-pulse 1.8s ease-in-out infinite;
    }
    /* heading */
    .tc-hero__title {
        font-family: 'Bebas Neue', 'Barlow', sans-serif;
        font-size: clamp(2.4rem, 7.5vw, 7.5rem);
        line-height: 0.92;
        letter-spacing: 0.02em;
        color: #fff;
        text-shadow: 0 4px 32px rgba(0,0,0,0.6);
    }

    .tc-hero__sub {
        font-size: clamp(0.9rem, 2vw, 1.15rem);
        font-weight: 300;
        line-height: 1.75;
        color: rgba(255,255,255,0.72);
        max-width: 520px;
    }
    /* form */
    .tc-form-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        width: 100%;
        max-width: 500px;
        border: 1px solid rgba(236,124,38,0.45);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        box-shadow: 0 0 30px rgba(236,124,38,0.12);
    }

    .tc-form__input {
        flex: 1;
        min-width: 0;
        background: rgba(255,255,255,0.10);
        border: none;
        outline: none;
        padding: 0.85rem 1.25rem;
        font-family: inherit;
        font-size: 0.9rem;
        color: #fff;
        -webkit-appearance: none;
        appearance: none;
    }

        .tc-form__input::placeholder {
            color: rgba(255,255,255,0.45);
        }

    .tc-form__btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--tc-orange);
        border: none;
        cursor: pointer;
        padding: 0.85rem 1.5rem;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--tc-coal);
        white-space: nowrap;
        transition: background var(--tc-transition), box-shadow var(--tc-transition), transform var(--tc-transition);
    }

        .tc-form__btn:hover {
            background: var(--tc-orange-d);
            box-shadow: 0 0 20px rgba(236,124,38,0.4);
            transform: scale(1.02);
        }
    /* status */
    .tc-status {
        font-size: 0.82rem;
        padding: 0.6rem 1.2rem;
        border-radius: 50px;
        font-weight: 500;
    }

    .tc-status--ok {
        background: rgba(80,200,80,0.18);
        color: #6ee86e;
        border: 1px solid rgba(80,200,80,0.3);
    }

    .tc-status--err {
        background: rgba(220,50,50,0.18);
        color: #ff8888;
        border: 1px solid rgba(220,50,50,0.3);
    }
    /* shared socials row */
    .tc-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        justify-content: center;
        position: relative;
        z-index: 2;
    }
    /* ── Light-background variant (about section) ── */
    .tc-socials--light {
        margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    }

    .tc-social-light {
        display: flex;
        align-items: center;
        justify-content: center;
        width: clamp(42px, 5vw, 48px);
        height: clamp(42px, 5vw, 48px);
        background: var(--tc-orange);
        border: 2px solid var(--tc-orange);
        border-radius: 12px;
        color: #fff;
        text-decoration: none;
        transition: background var(--tc-transition), border-color var(--tc-transition), color var(--tc-transition), transform var(--tc-transition), box-shadow var(--tc-transition);
    }

        .tc-social-light:hover {
            background: var(--tc-orange-d);
            border-color: var(--tc-orange-d);
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(236,124,38,0.35);
        }
    /* scroll indicator */
    .tc-scroll-ind {
        position: absolute;
        bottom: 5.5rem;
        right: clamp(1.5rem, 3vw, 2.5rem);
        z-index: 12;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        animation: tc-fadein 1.2s ease 1s both;
    }

    @@keyframes tc-fadein {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .tc-scroll-ind__label {
        font-size: 0.55rem;
        letter-spacing: 0.22em;
        color: rgba(255,255,255,0.45);
        writing-mode: vertical-rl;
    }

    .tc-scroll-ind__line {
        width: 1px;
        height: 48px;
        background: linear-gradient(to bottom, var(--tc-orange), transparent);
        animation: tc-scroll-line 1.6s ease-in-out infinite;
    }

    @@keyframes tc-scroll-line {
        0% {
            transform: scaleY(0) translateY(0);
            transform-origin: top;
            opacity: 1;
        }

        50% {
            transform: scaleY(1) translateY(0);
            transform-origin: top;
            opacity: 1;
        }

        100% {
            transform: scaleY(1) translateY(16px);
            opacity: 0;
        }
    }

    /* ── PARALLAX STRIP (marquee) ── */
    .tc-parallax-strip {
        position: relative;
        height: clamp(90px, 14vw, 160px);
        overflow: hidden;
        display: flex;
        align-items: center;
    }

    .tc-parallax-strip__bg {
        position: absolute;
        inset: -60px;
        background: linear-gradient(135deg, var(--tc-coal) 0%, #2C1A08 50%, var(--tc-coal) 100%);
        will-change: transform;
    }

    .tc-marquee {
        position: relative;
        z-index: 2;
        width: 100%;
        overflow: hidden;
    }

    .tc-marquee__track {
        display: flex;
        align-items: center;
        gap: 0;
        width: max-content;
        animation: tc-marquee 22s linear infinite;
    }

        .tc-marquee__track span {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(1.8rem, 4.5vw, 4rem);
            letter-spacing: 0.07em;
            color: transparent;
            -webkit-text-stroke: 1px rgba(236,124,38,0.28);
            padding: 0 clamp(1rem, 2.5vw, 2.5rem);
            user-select: none;
        }

        .tc-marquee__track .sep {
            color: rgba(236,124,38,0.35);
            -webkit-text-stroke: 0;
        }

    @@keyframes tc-marquee {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    /* ── ABOUT ── */
    .tc-about {
        position: relative;
        overflow: hidden;
        background: #f8f5f0;
        padding: clamp(1.5rem, 3vw, 3rem) clamp(1.25rem, 4vw, 3rem) clamp(3rem, 7vw, 7rem);
    }

    .tc-about__glow {
        position: absolute;
        top: -150px;
        right: -200px;
        width: clamp(300px, 60vw, 700px);
        height: clamp(300px, 60vw, 700px);
        background: radial-gradient(circle, rgba(236,124,38,0.07) 0%, transparent 65%);
        border-radius: 50%;
        pointer-events: none;
        will-change: transform;
    }

    .tc-about__inner {
        max-width: 820px;
        margin: 0 auto clamp(2.5rem, 5vw, 4rem);
        text-align: center;
        position: relative;
        z-index: 2;
    }

    .tc-section-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--tc-orange);
        margin-bottom: 0.75rem;
    }

        .tc-section-label::before {
            content: '';
            width: 24px;
            height: 1.5px;
            background: var(--tc-orange);
        }

    .tc-about__title {
        font-family: 'Bebas Neue', 'Barlow', sans-serif;
        font-size: clamp(1.8rem, 4vw, 3.5rem);
        letter-spacing: 0.03em;
        color: var(--tc-coal);
        margin-bottom: 1.25rem;
    }

    .tc-about__desc {
        font-size: clamp(0.85rem, 1.5vw, 1rem);
        font-weight: 300;
        line-height: 1.85;
        color: #4B5563;
    }

    /* ══ NETFLIX CAROUSEL ══ */
    .nc-root {
        position: relative;
        width: 100%;
        overflow: hidden;
        /* background: #0a0a0a; */
        padding: 2.5rem 0 2rem;
        min-height: 520px;
    }

        .nc-root::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(ellipse 70% 60% at 50% 40%, rgba(236,124,38,0.12) 0%, transparent 70%);
        }

    .nc-label {
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #EC7C26;
        margin-bottom: 2rem;
        position: relative;
        z-index: 2;
    }

        .nc-label::before {
            content: '';
            display: inline-block;
            width: 20px;
            height: 1.5px;
            background: #EC7C26;
            vertical-align: middle;
            margin-right: 8px;
        }

        .nc-label::after {
            content: '';
            display: inline-block;
            width: 20px;
            height: 1.5px;
            background: #EC7C26;
            vertical-align: middle;
            margin-left: 8px;
        }

    .nc-stage {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 650px;
        z-index: 2;
    }

    .nc-track {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        position: relative;
    }

    .nc-card {
        position: absolute;
        width: 400px;
        height: 600px;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.08);
        transition: transform 0.55s cubic-bezier(.4,0,.2,1), opacity 0.55s ease;
        will-change: transform, opacity;
        cursor: pointer;
    }

    .nc-card-img {
        width: 100%;
        height: 70%;
        overflow: hidden;
        display: block;
    }

    .nc-card-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform 0.45s ease;
    }

    .nc-card:hover .nc-card-photo {
        transform: scale(1.05);
    }

    /* .nc-card-img {
        width: 100%; height: 70%;
        display: flex; align-items: center; justify-content: center;
    }
    .nc-card-img svg {
        width: 100px; height: 100px;
    }
    */

    .nc-c1 {
        background: linear-gradient(160deg, #1a0800, #3d1500);
    }

    .nc-c2 {
        background: linear-gradient(160deg, #0a1a0a, #1a3a10);
    }

    .nc-c3 {
        background: linear-gradient(160deg, #001a2a, #003050);
    }

    .nc-c4 {
        background: linear-gradient(160deg, #1a0a00, #2e1800);
    }

    .nc-c5 {
        background: linear-gradient(160deg, #0a0a1a, #1a1a3a);
    }

    .nc-c6 {
        background: linear-gradient(160deg, #001a10, #003020);
    }

    .nc-card-body {
        padding: 20px 20px 24px;
        background: #111;
        height: 30%;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 8px;
    }

    .nc-tag {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #EC7C26;
        background: rgba(236,124,38,0.15);
        border-radius: 50px;
        padding: 3px 12px;
        display: inline-block;
        width: fit-content;
        margin-bottom: 5px;
    }

    .nc-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #fff;
        line-height: 1.35;
    }

    .nc-desc {
        font-size: 0.85em;
        color: rgba(255,255,255,0.45);
        line-height: 1.65;
        margin-top: 4px;
    }

    .nc-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid rgba(236,124,38,0.40);
        background: rgba(0,0,0,0.55);
        color: #fff;
        cursor: pointer;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background var(--tc-transition), border-color var(--tc-transition);
    }

        .nc-btn:hover {
            background: #EC7C26;
            border-color: #EC7C26;
        }

    .nc-btn--l {
        left: 16px;
    }

    .nc-btn--r {
        right: 16px;
    }

    .nc-dots {
        display: flex;
        gap: 6px;
        justify-content: center;
        margin-top: 1.5rem;
        position: relative;
        z-index: 2;
    }

    .nc-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

        .nc-dot.on {
            background: #EC7C26;
            transform: scale(1.4);
        }

    .nc-prog {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2px;
        background: #EC7C26;
        transition: width 0.05s linear;
        z-index: 3;
        border-radius: 0 2px 2px 0;
    }

    @@media (max-width: 1024px) {
        .nc-card {
            width: 300px;
            height: 460px;
