<!-- ═══════════════════════════════════════ HERO ═══════════════════════════════════════ -->
<section class="tc-hero">

    <!-- Carousel background -->
    <div class="carousel" aria-hidden="true">
        <div class="carousel-track" style="@($"transform: translateX({-currentIndex * 100}%);")">
            @foreach (var img in carouselImages)
            {
                <div class="carousel-slide">
                    <img src="@img" alt="carousel" />
                </div>
            }
        </div>
        <div class="carousel-overlay"></div>
    </div>

    <!-- Scan lines digital effect -->
    <div class="tc-hero__scanlines" aria-hidden="true"></div>

    <!-- Animated orange particle grid -->
    <div class="tc-hero__grid" aria-hidden="true"></div>

    <!-- Hero content -->
    <div class="tc-hero__content">
        <!-- Badge -->
        <div class="tc-badge">
            <span class="tc-badge__dot"></span>
            Precision &bull;
            <span class="tc-badge__dot"></span>
            Reliability &bull;
            <span class="tc-badge__dot"></span>
            TotalCare
        </div>

        <!-- Heading -->
        <h1 class="tc-hero__title">
            Powering Engineering Services <br /> All Under One Roof
        </h1>

        <!-- Subtitle -->
        <p class="tc-hero__sub">
            We are launching our website shortly.<br />
            Your trusted engineering service partner is on the way.
        </p>

        <!-- Email form -->
        <div class="tc-form-wrap">
            <input @bind="email"
                   type="email"
                   placeholder="Enter your email"
                   class="tc-form__input"
                   aria-label="Enter your email address for notifications" />
            <button @onclick="HandleNotifyMe" class="tc-form__btn" aria-label="Notify Me">
                Notify Me
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </button>
        </div>

        <!-- Status -->
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="tc-status @(isSuccess ? "tc-status--ok" : "tc-status--err")">
                @statusMessage
            </div>
        }
    </div>

    <!-- Scroll indicator -->
    <div class="tc-scroll-ind" aria-hidden="true">
        <span class="tc-scroll-ind__label">SCROLL</span>
        <div class="tc-scroll-ind__line"></div>
    </div>

</section>

<!-- ═══════════════════════════════════════ PARALLAX STRIP ═══════════════════════════════════════ -->
<div class="tc-parallax-strip">
    <div class="tc-parallax-strip__bg" id="parallaxBg1"></div>
    <div class="tc-marquee">
        <div class="tc-marquee__track">
            <span>AUTOMOTIVE</span><span class="sep">&bull;</span>
            <span>WELDING</span><span class="sep">&bull;</span>
            <span>HVAC</span><span class="sep">&bull;</span>
            <span>HYDRAULICS</span><span class="sep">&bull;</span>
            <span>ROOFING</span><span class="sep">&bull;</span>
            <span>ELECTRICAL</span><span class="sep">&bull;</span>

         
            <!-- duplicate for seamless loop -->

            <span>AUTOMOTIVE</span><span class="sep">&bull;</span>
            <span>WELDING</span><span class="sep">&bull;</span>
            <span>HVAC</span><span class="sep">&bull;</span>
            <span>HYDRAULICS</span><span class="sep">&bull;</span>
            <span>ROOFING</span><span class="sep">&bull;</span>
            <span>ELECTRICAL</span><span class="sep">&bull;</span>

