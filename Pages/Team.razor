@page "/team"

<PageTitle>TotalCare Engineering Services - Team</PageTitle>

<AppNavbar />

<section class="tc-partners">
    <div class="tc-section-label">Our Team</div>
    <p class="tc-partners__sub">Team build the power</p>

    <div class="tc-partners__grid">
        <div class="tc-partner-card">

            <div class="tc-partner-card__divider"></div>
            <div class="tc-partner-card__name">Team Member 1</div>
            <div class="tc-partner-card__type">des1</div>
        </div>
        <div class="tc-partner-card">

            <div class="tc-partner-card__divider"></div>
            <div class="tc-partner-card__name">Team Member 2</div>
            <div class="tc-partner-card__type">des2</div>
        </div>
        <div class="tc-partner-card">

            <div class="tc-partner-card__divider"></div>
            <div class="tc-partner-card__name">Team Member 3</div>
            <div class="tc-partner-card__type">des3</div>
        </div>
        <div class="tc-partner-card">

            <div class="tc-partner-card__divider"></div>
            <div class="tc-partner-card__name">Team Member 4</div>
            <div class="tc-partner-card__type">des4</div>
        </div>
    </div>
</section>

<style>
    /* ── PARTNERS ── */
    .tc-partners {
        background: #f8f5f0;
        padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem);
        text-align: center;
    }

    .tc-partners__title {
        font-family: 'Bebas Neue', 'Barlow', sans-serif;
        font-size: clamp(1.8rem, 4vw, 3rem);
        letter-spacing: 0.04em;
        color: var(--tc-coal);
        margin-bottom: 0.6rem;
    }

    .tc-partners__sub {
        font-size: clamp(0.85rem, 1.5vw, 0.95rem);
        font-weight: 300;
        color: var(--tc-muted);
        margin-bottom: clamp(2rem, 4vw, 3rem);
    }

    /* .tc-partners__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.5rem);
    max-width: 720px;
    margin: 0 auto;
    }  */

    /*  tc-partners__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2.5vw, 1.5rem);
    max-width: 520px;
    margin: 0 auto;
    } */

    .tc-partners__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: clamp(1rem, 2.5vw, 1.5rem);
        max-width: 960px;
        margin: 0 auto;
    }

   

    /* .tc-partner-card {
    background: #fff;
    border: 1px solid rgba(236,124,38,0.15);
    border-radius: var(--tc-radius);
    padding: clamp(1.5rem, 3vw, 2rem) 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transition: box-shadow var(--tc-transition), transform var(--tc-transition), border-color var(--tc-transition);
    } */

    .tc-partner-card:hover {
        box-shadow: 0 10px 30px rgba(236,124,38,0.16);
        transform: translateY(-5px);
        border-color: rgba(236,124,38,0.40);
    }

    .tc-partner-card__img {
        width: clamp(70px, 10vw, 100px);
        height: clamp(70px, 10vw, 100px);
        object-fit: contain;
        border-radius: 10px;
        padding: 8px;
        background: #f8f5f0;
        border: 1px solid rgba(236,124,38,0.12);
        transition: border-color var(--tc-transition);
    }

    .tc-partner-card:hover .tc-partner-card__img {
        border-color: rgba(236,124,38,0.45);
    }

    .tc-partner-card__divider {
        width: 28px;
        height: 1.5px;
        background: rgba(236,124,38,0.35);
        border-radius: 2px;
    }

    .tc-partner-card__name {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--tc-coal);
    }

    .tc-partner-card__type {
        font-size: 0.72rem;
        font-weight: 300;
        color: var(--tc-muted);
    }

   
    /* @@media (max-width: 480px) {
    .tc-partners__grid {
    grid-template-columns: 1fr;
    max-width: 280px;
    }
    } */

    @@media (max-width: 767px) {
        .tc-partners__grid {
            grid-template-columns: repeat(2, 1fr);
            max-width: 480px;
        }
    }

    @@media (max-width: 480px) {
        .tc-partners__grid {
            grid-template-columns: 1fr;
            max-width: 280px;
        }
    }

</style>

<!-- ═══════════════════════════════════════ FOOTER ═══════════════════════════════════════ -->
<AppFooter />
