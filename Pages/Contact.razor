                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        Visit Our Store
                    </h2>

                    <div class="tc-info-card">
                        <div class="tc-info-card__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                <polyline points="9 22 9 12 15 12 15 22" />
                            </svg>
                        </div>
                        <div class="tc-info-card__body">
                            <div class="tc-info-card__name">Head Office</div>
                            <div class="tc-info-card__detail">TotalCare Engineering Services (Pvt) Ltd.</div>
                            <div class="tc-info-card__detail tc-info-card__detail--muted">Colombo, Sri Lanka</div>
                        </div>
                    </div>

                    <!-- Business Hours -->
                    <div class="tc-info-card">
                        <div class="tc-info-card__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                        </div>
                        <div class="tc-info-card__body">
                            <div class="tc-info-card__name">Business Hours</div>
                            <div class="tc-info-card__detail">Mon – Fri: 8:00 AM – 6:00 PM</div>
                            <div class="tc-info-card__detail tc-info-card__detail--muted">Sat: 8:00 AM – 2:00 PM</div>
