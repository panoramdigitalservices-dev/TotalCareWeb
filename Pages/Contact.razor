@page "/contact"
@using TotalCareEngineering.Components

<PageTitle>TotalCare Engineering Services - Contact</PageTitle>

<AppNavbar />

<!-- ═══════════════════════════════════════ CONTACT HERO STRIP ═══════════════════════════════════════ -->
<div class="tc-page-hero">
    <div class="tc-page-hero__bg"></div>
    <div class="tc-page-hero__content">
        <div class="tc-section-label">Contact Us</div>
        <h1 class="tc-page-hero__title">Get In Touch</h1>
        <p class="tc-page-hero__sub">We're here to help. Reach out through any channel below.</p>
    </div>
</div>

<!-- ═══════════════════════════════════════ CONTACT BODY ═══════════════════════════════════════ -->
<section id="contact-us" class="tc-contact">
    <div class="tc-contact__inner">

        <div class="tc-contact__grid">

            <!-- ── Left Column: Visit & Follow ── -->
            <div class="tc-contact__col">

                <!-- Visit card -->
                <div class="tc-contact__card-group">
