                </div>
            </div>

            <!-- Get in Touch -->
            <div class="tc-contact__col">
                <h2 class="tc-contact__heading">Get in Touch</h2>

                <!-- Hotline -->
                <div class="tc-info-card">
                    <div class="tc-info-card__icon">
