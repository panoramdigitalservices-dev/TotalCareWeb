@namespace TotalCareEngineering.Components

<footer class="tc-footer">
    <div class="tc-footer__inner">

        <!-- Brand -->
        <div class="tc-footer__brand">TOTALCARE ENGINEERING SERVICES (PVT) LTD.</div>

        <!-- Tagline -->
        <div class="tc-footer__tagline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 width="18" height="18" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z" />
                <path d="M2 17l10 5 10-5" />
                <path d="M2 12l10 5 10-5" />
            </svg>
            One Roof. All Engineering Solutions. Coming Soon!
        </div>

        <!-- Quick links -->
        <div class="tc-footer__links">
            <a href="#about-us" class="tc-footer__link">About</a>
            <span class="tc-footer__sep">&bull;</span>
            <a href="contact" class="tc-footer__link">Contact</a>
            <span class="tc-footer__sep">&bull;</span>
            <a href="mailto:totalcareengineeringservices@gmail.com" class="tc-footer__link">Email Us</a>
        </div>

        <!-- Social icons -->
        <div class="tc-footer__socials">
            <a href="https://www.facebook.com/share/1BQVVPB5PD/?mibextid=wwXIfr" target="_blank" aria-label="Facebook" class="tc-footer__social">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
            </a>
            <a href="https://wa.me/94776171864" target="_blank" aria-label="WhatsApp" class="tc-footer__social">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
            </a>
            <a href="https://www.linkedin.com/company/total-care-engineering-services/" target="_blank" aria-label="LinkedIn" class="tc-footer__social">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
            </a>
            <a href="https://www.instagram.com/totalcare_engineering_services?igsh=cnNwb2tzNXp4aTg1" target="_blank" aria-label="Instagram" class="tc-footer__social">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg>
            </a>
            <a href="mailto:totalcareengineeringservices@gmail.com" aria-label="Email" class="tc-footer__social">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
            </a>
        </div>

        <!-- Copyright -->
        <div class="tc-footer__copy">
            &copy; @currentYear TotalCare Engineering Services (Pvt) Ltd. All rights reserved.
        </div>

    </div>
</footer>

<style>
    .tc-footer {
        background: linear-gradient(135deg, #EC7C26 0%, #C9621A 100%);
        padding: clamp(1.75rem, 4vw, 3rem) clamp(1.25rem, 4vw, 3rem);
        position: relative;
        overflow: hidden;
    }

        .tc-footer::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23fff' fill-opacity='0.05'%3E%3Cpath d='M0 0h20v20H0zM20 20h20v20H20z'/%3E%3C/g%3E%3C/svg%3E");
        }

    .tc-footer__inner {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        text-align: center;
    }

    .tc-footer__brand {
        font-family: 'Bebas Neue', 'Barlow', sans-serif;
        font-size: clamp(1rem, 3vw, 1.8rem);
        letter-spacing: 0.06em;
        color: #0F0A05;
        line-height: 1.1;
    }

    .tc-footer__tagline {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: clamp(0.75rem, 1.5vw, 0.92rem);
        font-weight: 400;
        color: rgba(15,10,5,0.72);
    }

    /* quick links */
    .tc-footer__links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }

    .tc-footer__link {
        font-size: clamp(0.7rem, 1.2vw, 0.8rem);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(15,10,5,0.70);
        text-decoration: none;
        transition: color 220ms ease;
    }

        .tc-footer__link:hover {
            color: #0F0A05;
        }

    .tc-footer__sep {
        color: rgba(15,10,5,0.35);
        font-size: 0.6rem;
    }

    /* social icons row */
    .tc-footer__socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin-top: 0.25rem;
    }

    .tc-footer__social {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(15,10,5,0.12);
        color: rgba(15,10,5,0.70);
        text-decoration: none;
        transition: background 220ms ease, color 220ms ease, transform 220ms ease;
    }

        .tc-footer__social:hover {
            background: rgba(15,10,5,0.22);
            color: #0F0A05;
            transform: translateY(-3px);
        }

    .tc-footer__copy {
        font-size: clamp(0.62rem, 1.2vw, 0.75rem);
        color: rgba(15,10,5,0.50);
        margin-top: 0.35rem;
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 480px) {
        .tc-footer__tagline {
            flex-direction: column;
            gap: 4px;
        }

        .tc-footer__links {
            gap: 0.4rem;
        }
    }
</style>

@code {
    private int currentYear = DateTime.Now.Year;
}
